<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Pcci</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <!-- Unpackaged: there is no code-signing certificate for this project, and an
         unsigned MSIX refuses to install, so a plain folder is what ships.
         EnableMsixTooling is still required. Despite the name it is not only about
         packaging: it brings in the MRT tooling that generates the .pri resource
         indexes WinUI needs at runtime. Without it the build dies in
         MrtCore.PriGen.targets looking for Microsoft.Build.Packaging.Pri.Tasks.dll. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <!-- The frozen engine ships beside the app as engine\pcci.exe. build-windows.ps1
       puts it there; this copies it into the output so F5 works during development. -->
  <ItemGroup>
    <None Include="..\..\build\engine\pcci\**\*" Condition="Exists('..\..\build\engine\pcci')">
      <Link>engine\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\docs\STAGE_SETUP.md" Condition="Exists('..\..\docs\STAGE_SETUP.md')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
